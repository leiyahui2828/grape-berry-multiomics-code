# Normalize text files in this bioinformatics repository
* text=auto

# Linux / bioinformatics scripts
*.sh   text eol=lf
*.R    text eol=lf
*.py   text eol=lf
*.pl   text eol=lf

# Configuration and documentation
*.md   text eol=lf
*.txt  text eol=lf
*.tsv  text eol=lf
*.csv  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Git configuration files
.gitignore text eol=lf
.gitattributes text eol=lf
